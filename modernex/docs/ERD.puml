  entity accounts {
    * id : TEXT <<PK>>
    --
    * name : TEXT
    * group_id : TEXT <<FK>>
    * code : TEXT <<UNIQUE>>
    * is_debit_balance : INTEGER
    opening_balance_paise : INTEGER
    is_system : INTEGER
    active : INTEGER
  }

  entity journal_vouchers {
    * id : TEXT <<PK>>
    --
    * date : TEXT
    * type : TEXT  ' journal|payment|receipt|contra
    * narration : TEXT
    ref_module : TEXT
    ref_id : TEXT
    created_by : TEXT
  }

  entity journal_entries {
    * id : INTEGER <<PK, AI>>
    --
    * voucher_id : TEXT <<FK>>
    * account_id : TEXT <<FK>>
    * debit_paise : INTEGER
    * credit_paise : INTEGER
    narration : TEXT
  }

  entity cost_centres {
    * id : TEXT <<PK>>
    --
    * name : TEXT
    parent_id : TEXT <<FK self>>
    active : INTEGER
  }

  entity journal_entry_cc {
    * entry_id : INTEGER <<PK, FK>>
