@startuml Modernex_ERD
!pragma layout smetana
!theme plain
skinparam linetype ortho
skinparam shadowing false
skinparam class {
  BackgroundColor White
  BorderColor #555555
  HeaderBackgroundColor #DDEEFF
  FontSize 11
}
skinparam note {
  BackgroundColor #FFFFF0
  BorderColor #999999
}

' ═══════════════════════════════════════════════════════════════
' DOMAIN PACKAGES
' ═══════════════════════════════════════════════════════════════

package "Auth & Users" #E8F4FD {

  entity users {
    * id : INTEGER <<PK, AI>>
    --
    * username : TEXT <<UNIQUE>>
    * password_hash : TEXT
    * full_name : TEXT
    * role : TEXT  ' admin|accounts|yard|sales
    email : TEXT
    phone : TEXT
    active : INTEGER
    failed_attempts : INTEGER
    locked_until : TEXT
    must_change_password : INTEGER
  }

  entity refresh_tokens {
    * id : TEXT <<PK>>
    --
    * user_id : INTEGER <<FK>>
    * issued_at : TEXT
    * expires_at : TEXT
    revoked : INTEGER
    ip_address : TEXT
  }

}

package "Master Data" #FFF3E0 {

  entity customers {
    * id : TEXT <<PK>>
    --
    * name : TEXT
    gstin : TEXT
    * state : TEXT
    address : TEXT
    contact : TEXT
    email : TEXT
    credit_days : INTEGER
    credit_limit_paise : INTEGER
    outstanding_paise : INTEGER
    preferred_currency : TEXT
    interest_rate_pct : REAL
  }

  entity vendors {
    * id : TEXT <<PK>>
    --
    * name : TEXT
    gstin : TEXT
    * state : TEXT
    * type : TEXT  ' Quarry|Broker|Transporter|Other
    msme : INTEGER
    msme_number : TEXT
    pan : TEXT
    tds_section : TEXT
    tds_exempt : INTEGER
    deductee_type : TEXT
  }

  entity collection_accounts {
    * id : TEXT <<PK>>
    --
    * name : TEXT
    * kind : TEXT  ' upi|bank|both
    upi_id : TEXT
    account_number : TEXT
    ifsc : TEXT
    bank_name : TEXT
    is_default : INTEGER
    active : INTEGER
  }

  entity locations {
    * id : TEXT <<PK>>
    --
    * name : TEXT
    * location_type : TEXT  ' quarry|yard|machine|showroom|dispatch|virtual
    stage_hint : TEXT
    is_active : INTEGER
    sort_order : INTEGER
  }

  entity variety_master {
    * id : TEXT <<PK>>
    --
    * name : TEXT
    region : TEXT
    category : TEXT
    default_hsn : TEXT
    active : INTEGER
  }

  entity company_details {
    * id : INTEGER <<PK, CHECK=1>>
    --
    * name : TEXT
    * gstin : TEXT
    * pan : TEXT
    * address : TEXT
    * state : TEXT
    fy : TEXT
    invoice_prefix : TEXT
    einvoice_threshold_paise : INTEGER
  }

}

package "Inventory / Products" #E8F5E9 {

  entity products {
    * id : TEXT <<PK>>
    --
    * kind : TEXT  ' block|slab|tile|cts|strip|kerb|cobble|chips|dust|monument
    * variety : TEXT
    * hsn : TEXT
    * uom : TEXT
    grade : TEXT
    lot_id : TEXT
    * rate_paise : INTEGER
    stock : REAL
    unit_cost_paise : INTEGER
    source_product_id : TEXT <<FK self>>
    current_location_id : TEXT <<FK>>
    active : INTEGER
  }

  entity product_blocks {
    * product_id : TEXT <<PK, FK>>
    --
    * length_m : REAL
    * width_m : REAL
    * height_m : REAL
    * cft : REAL
    source_quarry : TEXT
  }

  entity product_slabs {
    * product_id : TEXT <<PK, FK>>
    --
    * size_lw : TEXT  ' "2600×1600" mm
    * thickness_mm : INTEGER
    * sqft : REAL
  }

  entity product_tiles {
    * product_id : TEXT <<PK, FK>>
    --
    * size_lw : TEXT
    * thickness_mm : INTEGER
    * sqft_per_tile : REAL
    pieces_per_box : INTEGER
  }

  entity product_cts {
    * product_id : TEXT <<PK, FK>>
    --
    customer_spec : TEXT
    * length_mm : INTEGER
    * width_mm : INTEGER
    * thickness_mm : INTEGER
    * sqft : REAL
  }

  entity product_strips {
    * product_id : TEXT <<PK, FK>>
    --
    * length_mm : INTEGER
    * width_mm : INTEGER
    * thickness_mm : INTEGER
    * rft_per_piece : REAL
  }

  entity product_kerbs {
    * product_id : TEXT <<PK, FK>>
    --
    * profile : TEXT
    * length_mm : INTEGER
    * height_mm : INTEGER
    * width_mm : INTEGER
  }

  entity product_cobbles {
    * product_id : TEXT <<PK, FK>>
    --
    * cobble_type : TEXT
    length_mm : INTEGER
    width_mm : INTEGER
    height_mm : INTEGER
  }

  entity product_chips {
    * product_id : TEXT <<PK, FK>>
    --
    * mesh_size_mm : REAL
    bulk_density : REAL
  }

  entity product_monuments {
    * product_id : TEXT <<PK, FK>>
    --
    * monument_type : TEXT
    * length_mm : INTEGER
    * width_mm : INTEGER
    * thickness_mm : INTEGER
  }

  entity inventory_moves {
    * id : INTEGER <<PK, AI>>
    --
    * product_id : TEXT <<FK>>
    qty : REAL
    from_location_id : TEXT <<FK>>
    to_location_id : TEXT <<FK>>
    * move_type : TEXT  ' receive|move|consume|produce|dispatch|adjust
    job_id : TEXT <<FK>>
    created_at : TEXT
    created_by : TEXT
  }

}

