' ═══════════════════════════════════════════════════════════════
' RELATIONSHIPS
' ═══════════════════════════════════════════════════════════════

' Auth
users ||--o{ refresh_tokens : "has"

' Purchasing
vendors ||--o{ purchase_orders : "supplies (vendor)"
vendors |o--o{ purchase_orders : "transports (transport_vendor)"
purchase_orders ||--o{ purchase_order_receipts : "received via"
purchase_orders ||--o{ tds_transactions : "triggers"
purchase_orders ||--o{ payments : "paid by"
purchase_orders ||--o{ post_dated_cheques : "secured by"
vendors ||--o{ tds_transactions : "deducted from"
vendors ||--o{ fixed_assets : "purchased from"
vendors ||--o{ post_dated_cheques : "issued to"
payments |o--o| tds_transactions : "ref"
tds_transactions }o--o| tds_challans : "deposited via"

' Production
production_jobs ||--o{ production_job_inputs : "consumes"
production_jobs ||--o{ production_job_outputs : "produces"
production_jobs ||--o{ inventory_moves : "triggers"
products ||--o{ production_job_inputs : "consumed by"
products ||--o{ production_job_outputs : "created by"
products |o--o| products : "sourced from (self)"

' Inventory — product subtypes (1-to-1 extension)
products ||--o| product_blocks : "spec"
products ||--o| product_slabs : "spec"
products ||--o| product_tiles : "spec"
products ||--o| product_cts : "spec"
products ||--o| product_strips : "spec"
products ||--o| product_kerbs : "spec"
products ||--o| product_cobbles : "spec"
products ||--o| product_chips : "spec"
products ||--o| product_monuments : "spec"

products }o--o| locations : "at location"
products ||--o{ inventory_moves : "tracked by"
locations ||--o{ inventory_moves : "from"
locations ||--o{ inventory_moves : "to"

' Sales
customers ||--o{ invoices : "billed to"
customers ||--o{ debit_credit_notes : "issued to"
customers ||--o{ post_dated_cheques : "given by"
customers ||--o{ delivery_challans : "delivered to"
invoices ||--o{ invoice_items : "contains"
invoices ||--o{ payments : "settled by"
invoices ||--o{ post_dated_cheques : "secured by"
invoices ||--o{ debit_credit_notes : "adjusted via"
invoices ||--o{ delivery_challans : "dispatched via"
invoice_items }o--o| products : "from stock"
delivery_challans ||--o{ delivery_challan_items : "contains"
delivery_challan_items }o--o| products : "includes"
collection_accounts |o--o{ invoices : "collected into"

' Accounting / CoA
account_groups ||--o{ accounts : "classifies"
account_groups |o--o| account_groups : "parent (self)"
accounts ||--o{ journal_entries : "posted to"
journal_vouchers ||--o{ journal_entries : "contains"
journal_entries ||--o{ journal_entry_cc : "split by"
cost_centres ||--o{ journal_entry_cc : "allocated to"
cost_centres |o--o| cost_centres : "parent (self)"
accounts |o--o{ budgets : "budgeted in"
account_groups |o--o{ budgets : "budgeted in"
recurring_vouchers ||--o{ recurring_voucher_lines : "defines"
recurring_voucher_lines }o--o| accounts : "to/from"

' Banking
accounts ||--o| bank_accounts_reg : "linked to"
bank_accounts_reg ||--o{ bank_statement_lines : "has lines"
bank_statement_lines }o--o| payments : "matched to"

' Fixed Assets
accounts ||--o{ fixed_assets : "capitalised in"
fixed_assets ||--o{ asset_depreciation_log : "depreciated in"
journal_vouchers |o--o{ asset_depreciation_log : "journaled via"

' GST
gstr2b_imports ||--o{ gstr2b_records : "contains"
gstr2b_records }o--o| purchase_orders : "matched to"

' HR / Payroll
employees ||--o{ payroll_entries : "paid via"
employees ||--o{ bonus_entries : "awarded via"
employees ||--o{ leave_balances : "tracks"
employees ||--o{ leave_applications : "applies for"
employees ||--o{ employee_tax_declarations : "declares"
employees ||--o{ gratuity_records : "earns"
payroll_runs ||--o{ payroll_entries : "run contains"
bonus_runs ||--o{ bonus_entries : "run contains"

@enduml
