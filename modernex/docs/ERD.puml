  }

  entity tds_sections {
    * id : TEXT <<PK>>
    --
    * section : TEXT
    * description : TEXT
    * rate_pct : REAL
    threshold_paise : INTEGER
  }

  entity tds_transactions {
    * id : TEXT <<PK>>
    --
    * vendor_id : TEXT <<FK>>
    po_id : TEXT <<FK>>
    payment_id : TEXT <<FK>>
    * section_id : TEXT
