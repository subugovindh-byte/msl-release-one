}

package "Sales" #FFFDE7 {

  entity invoices {
    * id : TEXT <<PK>>
    --
    * date : TEXT
    * customer_id : TEXT <<FK>>
    * customer_name : TEXT  ' denormalised
    collection_account_id : TEXT <<FK>>
    discount_pct : REAL
    * taxable_paise : INTEGER
    cgst_paise : INTEGER
    sgst_paise : INTEGER
    igst_paise : INTEGER
    * total_paise : INTEGER
    paid : INTEGER
    due_date : TEXT
    irn : TEXT
    eway_bill : TEXT
    currency : TEXT
    export_type : TEXT  ' NONE|WITHOUT_TAX|WITH_TAX|DEEMED
  }

  entity invoice_items {
    * id : INTEGER <<PK, AI>>
    --
    * invoice_id : TEXT <<FK>>
    * line_no : INTEGER
    product_id : TEXT <<FK>>
    * variety : TEXT
    * hsn : TEXT
    * uom : TEXT
    * qty : REAL
    * rate_paise : INTEGER
    * line_total_paise : INTEGER
    dimension_snapshot : TEXT  ' JSON
    grade : TEXT
  }

  entity payments {
    * id : TEXT <<PK>>
    --
    * date : TEXT
    * type : TEXT  ' receipt|payment
    invoice_id : TEXT <<FK>>
    po_id : TEXT <<FK>>
    * party : TEXT
    * amount_paise : INTEGER
    * mode : TEXT
    utr : TEXT
    * category : TEXT  ' general|quarry|transport|invoice|refund|advance
  }

  entity post_dated_cheques {
    * id : TEXT <<PK>>
    --
    invoice_id : TEXT <<FK>>
    po_id : TEXT <<FK>>
    customer_id : TEXT <<FK>>
    vendor_id : TEXT <<FK>>
    * amount_paise : INTEGER
    * cheque_date : TEXT
    * cheque_no : TEXT
    status : TEXT  ' pending|presented|cleared|bounced|cancelled
  }

  entity debit_credit_notes {
    * id : TEXT <<PK>>
    --
    * customer_id : TEXT <<FK>>
    ref_invoice_id : TEXT <<FK>>
    * type : TEXT  ' debit|credit
    * amount_paise : INTEGER
    * reason : TEXT
    status : TEXT  ' draft|confirmed|cancelled
  }

  entity delivery_challans {
    * id : TEXT <<PK>>
    --
    * customer_id : TEXT <<FK>>
    invoice_id : TEXT <<FK>>
    * date : TEXT
    status : TEXT
  }

  entity delivery_challan_items {
    * id : INTEGER <<PK, AI>>
    --
    * challan_id : TEXT <<FK>>
    product_id : TEXT <<FK>>
    * qty : REAL
  }

}

package "Accounting & CoA" #E0F2F1 {

