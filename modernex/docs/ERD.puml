package "Production" #F3E5F5 {

  entity production_jobs {
    * id : TEXT <<PK>>
    --
    lot_id : TEXT
    * stage : TEXT  ' split|cut|polish|done
    * status : TEXT  ' New|In Progress|Complete|Cancelled
    * date : TEXT
    labour_paise : INTEGER
    power_paise : INTEGER
    consumables_paise : INTEGER
