# Build artifacts
node_modules
dist
build
*.tsbuildinfo

# Dependencies
# NOTE: package-lock.json must NOT be ignored — `npm ci` requires it, and it is
# what makes the image build reproducible. Excluding it silently broke the build.
yarn.lock
pnpm-lock.yaml

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode
.idea
*.swp
*.swo

# Testing
coverage
.nyc_output

# Database (if building backend too)
data/*.db
data/*.db-wal
data/*.db-shm

# Cache
.cache
.eslintcache

# Temp
tmp
temp
*.tmp

# Deployment / CI artifacts — never belong in the build context
deploy.zip
logs.zip
LogFiles
deployments
test-results
playwright-report
docs
