# ════════════════════════════════════════════════════
# MODERNEX STONES — ENVIRONMENT VARIABLES
# Copy this file to .env and fill with real values.
# In production, inject via Azure App Service Application Settings
# (which pulls from Key Vault via Managed Identity).
# ════════════════════════════════════════════════════

# ── ENVIRONMENT ──
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ── DATABASE ──
# Relative in dev, absolute in production (Azure persistent volume)
DB_PATH=./data/modernex.db

# ── AUTH ──
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-32-byte-random-hex-in-production
JWT_EXPIRY=8h
REFRESH_EXPIRY=30d
BCRYPT_ROUNDS=12

# ── FIRST-RUN ADMIN (used by seed.js — only on first boot when no users exist) ──
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
ADMIN_PASSWORD=change-me-before-production

# ── CORS ──
CORS_ORIGIN=http://localhost:5173

# ── FRONTEND (split-deployment only) ──
# Set this when frontend and API are on different origins.
# Leave blank for monolithic deployment (API serves the frontend).
# VITE_API_URL=https://api.modernexstones.in/api

# ── AZURE BLOB (backup) ──
# In production, set via Key Vault reference:
# @Microsoft.KeyVault(SecretUri=https://modernex-vault.vault.azure.net/secrets/BLOB-CONN/)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=backups
AZURE_PHOTOS_CONTAINER=modernex-photos

# ── GST / e-INVOICE ──
# Sandbox: https://einv-apisandbox.nic.in
# Production: https://einvoice1.gst.gov.in/eivital
IRP_BASE_URL=https://einv-apisandbox.nic.in
IRP_CLIENT_ID=
IRP_CLIENT_SECRET=
IRP_USERNAME=
IRP_PASSWORD=

GSTIN=33AABFM1234A1Z7
HSN_CODE=2516

# ── COMPANY ──
COMPANY_NAME=MODERNEX STONES LLP
COMPANY_ADDRESS=Survey No.142, Chendarapalli, Krishnagiri, Tamil Nadu 635001
COMPANY_STATE=Tamil Nadu
COMPANY_UPI=modernexstones@hdfcbank

# ── SMTP (invoice delivery) ──
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Modernex Stones <billing@modernexstones.in>"

# ── APP INSIGHTS ──
APPINSIGHTS_CONNECTION_STRING=

# ── WHATSAPP ──
# Provider: 'meta' (WhatsApp Cloud API) or 'twilio'
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API (https://developers.facebook.com/docs/whatsapp)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me-webhook-verify-token

# Twilio WhatsApp (alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── FEATURE FLAGS ──
ENABLE_IRP=false
ENABLE_UPI_COLLECT=false
ENABLE_WHATSAPP=false
ENABLE_MULTI_CURRENCY=false
