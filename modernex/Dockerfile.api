# ══════════════════════════════════════════
# API-only image — Node.js + Express + SQLite
# Use this for split-deployment (API on one host,
# frontend served separately via nginx or CDN).
# ══════════════════════════════════════════

FROM node:20-alpine AS runtime

WORKDIR /app

# Build deps for better-sqlite3 native bindings
RUN apk add --no-cache python3 make g++ curl tzdata
ENV TZ=Asia/Kolkata

# Copy workspace manifests first for better layer caching
COPY package.json package-lock.json ./
COPY packages/api/package.json ./packages/api/
COPY packages/shared/package.json ./packages/shared/

# Install only api + shared workspace deps (skip web)
RUN npm ci --workspace=@modernex/api --workspace=@modernex/shared

# Copy source files
COPY packages/api ./packages/api
COPY packages/shared ./packages/shared

# Persistent data directory
RUN mkdir -p /app/data && chown -R node:node /app

USER node

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:8080/api/health || exit 1

ENV NODE_ENV=production
ENV PORT=8080
ENV DB_PATH=/app/data/modernex.db

CMD ["node", "packages/api/src/server.js"]
